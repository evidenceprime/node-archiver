{
  "name": "@evidenceprime/archiver",
  "version": "7.0.4",
  "description": "a streaming interface for archive generation",
  "homepage": "https://github.com/evidenceprime/node-archiver",
  "author": {
    "name": "Chris Talkington",
    "url": "http://christalkington.com/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/evidenceprime/node-archiver.git"
  },
  "bugs": {
    "url": "https://github.com/evidenceprime/node-archiver/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "mocha --reporter dot",
    "bench": "node benchmark/simple/pack-zip.js",
    "release": "npm run build && npm publish"
  },
  "dependencies": {
    "async": "3.2.6",
    "buffer-crc32": "1.0.0",
    "is-stream": "4.0.1",
    "lazystream": "1.0.1",
    "normalize-path": "3.0.0",
    "readable-stream": "4.7.0",
    "readdir-glob": "2.0.1",
    "tar-stream": "3.1.7",
    "zip-stream": "7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/async": "3.2.25",
    "@types/node": "25.0.10",
    "@types/readable-stream": "4.0.23",
    "archiver-jsdoc-theme": "1.1.3",
    "chai": "6.2.2",
    "jsdoc": "4.0.5",
    "mkdirp": "3.0.1",
    "mocha": "11.7.5",
    "rimraf": "6.1.2",
    "stream-bench": "0.1.2",
    "tar": "7.5.6",
    "typescript": "5.9.3",
    "yauzl": "3.2.0"
  },
  "keywords": [
    "archive",
    "archiver",
    "stream",
    "zip",
    "tar"
  ],
  "packageManager": "yarn@4.12.0"
}
